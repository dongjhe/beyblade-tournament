rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['title', 'mode', 'date', 'location', 'ownerUid', 'open', 'deleted', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.mode in ['league', 'knockout']
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.location is string
        && request.resource.data.location.size() >= 1
        && request.resource.data.location.size() <= 100
        && request.resource.data.deleted == false
        && request.resource.data.open == true
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open', 'deleted'])
        && request.resource.data.open is bool
        && (
          (resource.data.get('deleted', false) == false && request.resource.data.get('deleted', false) == false)
          ||
          (resource.data.get('deleted', false) == false && request.resource.data.deleted == true && request.resource.data.open == false)
        );

      allow delete: if false;

      match /public/{documentId} {
        allow read: if request.auth != null && documentId == 'schedule'
          && get(/databases/$(database)/documents/events/$(eventId)).data.get('deleted', false) == false;
        allow create, update: if request.auth != null && documentId == 'schedule'
          && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/events/$(eventId)).data.get('deleted', false) == false
          && request.resource.data.keys().hasOnly(['mode','players','matches','updatedAt'])
          && request.resource.data.mode in ['league','knockout']
          && request.resource.data.players is list
          && request.resource.data.players.size() <= 64
          && request.resource.data.matches is list
          && request.resource.data.matches.size() <= 2016
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /registrations/{registrationId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/events/$(eventId))
          && get(/databases/$(database)/documents/events/$(eventId)).data.open == true
          && get(/databases/$(database)/documents/events/$(eventId)).data.get('deleted', false) == false
          && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 30
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /events/main/registrations/{registrationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
